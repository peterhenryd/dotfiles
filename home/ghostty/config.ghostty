# Ghostty's settings. ~/.config/ghostty/config.ghostty links here, so a change
# applies on Ghostty → Reload Configuration (⌘⇧,), with no rebuild, and shows
# up in `git status`. Every option, with docs:
# `ghostty +show-config --default --docs`.

# The font is Ghostty's built-in JetBrains Mono.
font-size = 12

# Matches the Neovim colorscheme, which expects a translucent background.
theme = Catppuccin Mocha
# Black with a blue tint, in place of the theme's background.
background = #0b1020
background-opacity = 0.8
background-blur = 20

# The title bar takes the terminal's background color.
macos-titlebar-style = transparent

# Left Option is Meta (⌥b/⌥f in zsh, Alt maps in Neovim); right Option still
# types special characters.
macos-option-as-alt = left

window-padding-x = 8
window-padding-y = 6
window-save-state = always
mouse-hide-while-typing = true
copy-on-select = clipboard
# ssh-terminfo installs Ghostty's terminfo on hosts you ssh into.
shell-integration-features = sudo,title,ssh-terminfo

# ⌃` drops down a terminal from any app. Global keybinds need Accessibility
# permission for Ghostty.
keybind = global:ctrl+grave_accent=toggle_quick_terminal
